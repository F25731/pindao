# ===== 基础配置 =====
APP_NAME=guangya-resource-bot
SECRET_KEY=change-this-to-a-random-string
DEBUG=false

# ===== 管理员 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/guangya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guangya

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== 光鸭接口 =====
GUANGYA_API_BASE=https://api.guangyapan.com
GUANGYA_ACCOUNT_BASE=https://account.guangyapan.com

# ===== Worker 配置 =====
WORKER_MAX_CONCURRENT=2
WORKER_POLL_INTERVAL=10
WORKER_MAX_RETRIES=3
WORKER_TASK_TIMEOUT=300

# ===== Telegram / 推送 =====
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=

# ===== 安全 =====
API_KEY_SALT=change-this-salt
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
